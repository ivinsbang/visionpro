{
  "name": "cme-spatial-market-center-preview",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:browser && npm run test:visionos",
    "test:unit": "npm run check:simulation && node --test tests/unit/*.test.js ../../packages/TradingSimulation/Tests/TradingSimulationTests/*.test.mjs",
    "test:browser": "playwright test",
    "build:simulation": "node scripts/sync-paper-trading.js",
    "check:simulation": "node scripts/sync-paper-trading.js --check",
    "build:visionos": "npm run build:simulation && node scripts/build-visionos.js",
    "check:visionos": "node scripts/build-visionos.js --check",
    "test:visionos": "npm run check:visionos && playwright test --config playwright.visionos.config.js",
    "record:demo": "node scripts/record-demo.js",
    "record:spatial": "node scripts/record-spatial-demo.js",
    "record:desk": "node scripts/record-desk-demo.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "three": "0.180.0"
  }
}
